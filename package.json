{
  "name": "gamelens-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "GameLens — a game designer AI lens for programmers. Monorepo for the MCP server and marketing site.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=gamelens",
    "build:site": "npm run build --workspace=@gamecodex/site",
    "build:all": "npm run build --workspaces",
    "dev": "npm run dev --workspace=gamelens",
    "dev:site": "npm run dev --workspace=@gamecodex/site",
    "start": "npm run start --workspace=gamelens",
    "typecheck": "npm run typecheck --workspace=gamelens",
    "test": "npm run test --workspace=gamelens",
    "lint:site": "npm run lint --workspace=@gamecodex/site"
  },
  "author": "sbenson2",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
