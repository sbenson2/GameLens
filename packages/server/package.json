{
  "name": "gamelens",
  "version": "3.0.0",
  "description": "A game designer AI lens for programmers — one MCP tool that applies industry-proven design philosophies (Cerny's Method, MDA, game feel, juice, flow, scope discipline…) to whatever you're building.",
  "main": "dist/index.js",
  "bin": {
    "gamelens": "dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node --import tsx --test src/__tests__/*.test.ts",
    "test:ci": "node --import tsx --test src/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "gamedev",
    "game-development",
    "game-design",
    "design-lens",
    "game-feel",
    "mda",
    "juice",
    "playtesting",
    "gamelens",
    "model-context-protocol",
    "ai",
    "ai-assistant",
    "game-ai",
    "claude",
    "cursor",
    "windsurf"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbenson2/GameLens.git"
  },
  "homepage": "https://github.com/sbenson2/GameLens",
  "bugs": {
    "url": "https://github.com/sbenson2/GameLens/issues"
  },
  "author": "sbenson2",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "docs",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  }
}
